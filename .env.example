# Desenvolvimento local apenas; substitua pelos seus próprios serviços. Nunca versionar .env.
PORT=8080
DATABASE_URL=
APP_ID=perswebrh
APP_SECRET=
AUTH_MODE=local
ALLOW_REGISTRATION=true
STORAGE_DRIVER=local
STORAGE_DIR=data/storage
OWNER_OPEN_ID=

# InfinitePay (Checkout Integrado) - SOMENTE servidor, nunca no frontend.
# Sem esta chave o sistema opera em modo simulado (nunca confirma pagamento sozinho).
INFINITEPAY_API_KEY=
# URL publica usada para redirect_url e webhook do checkout (opcional; deduzida do request)
APP_PUBLIC_URL=
# Habilita o endpoint de simulacao de pagamento (dev/testes apenas; nunca usar com API key real)
BILLING_SIMULATION=0
